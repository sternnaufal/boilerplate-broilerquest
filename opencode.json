{
  "$schema": "https://opencode.ai/config.json",
  "model": "commandcode/deepseek/deepseek-v4-pro",
  "small_model": "commandcode/deepseek/deepseek-v4-flash",
  "provider": {
    "commandcode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Command Code Provider API",
      "options": {
        "baseURL": "https://api.commandcode.ai/provider/v1"
      },
      "models": {
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        }
      }
    }
  },
  "mcp": {
    "unityMCP": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp",
      "enabled": true
    },
    "sigmap": {
      "type": "local",
      "command": [
        "npx",
        "sigmap",
        "--mcp"
      ],
      "enabled": true
    },
    "semble": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "semble[mcp]",
        "python",
        "-c",
        "import asyncio; from semble.mcp import serve; asyncio.run(serve(r'D:\\Bandung Lautan Api\\boilerplate-broilerquest'))"
      ],
      "enabled": true
    }
  }
}
